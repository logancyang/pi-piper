{
  "name": "@logancyang/pi-piper",
  "version": "0.1.0",
  "description": "A durable runner for always-on Pi agents and leader/worker coding loops",
  "type": "module",
  "license": "MIT",
  "author": "Logan Yang",
  "keywords": [
    "pi",
    "pi-agent",
    "coding-agent",
    "agent",
    "durable",
    "daemon",
    "cli",
    "leader-worker",
    "github",
    "automation",
    "llm"
  ],
  "homepage": "https://github.com/logancyang/pi-piper#readme",
  "bugs": {
    "url": "https://github.com/logancyang/pi-piper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logancyang/pi-piper.git"
  },
  "bin": {
    "piper": "dist/main.js"
  },
  "files": [
    "dist/",
    "prompts/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/main.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
